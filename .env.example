# Monde environment reference
#
# Two runtimes care about this file:
#   - Client (Vite) loads VITE_* variables from a local .env automatically.
#   - Server (monde-mind) reads process environment variables directly and does
#     NOT load .env files. Export the server variables in your shell before
#     `npm run dev:server` (or start node with --env-file=.env).
#
# Default setup below: Anthropic (Claude). The local/free LLM (Ollama)
# alternative is commented out — uncomment one block or the other, not both.

# ════════════════════════════════════════════════════════════════
# Server — provider: anthropic (default)
# ════════════════════════════════════════════════════════════════
MIND_PROVIDER=anthropic
# Claude via @anthropic-ai/sdk; required for live residents.
# ANTHROPIC_API_KEY=sk-ant-...
# Only when the key is org-level rather than scoped to a workspace.
# ANTHROPIC_WORKSPACE_ID=
# Per-role model overrides (optional; all roles default to claude-haiku-5-5).
# On the anthropic path these take strict Claude ids only:
# claude-haiku-5-5, claude-sonnet-5-5, claude-opus-5-5, claude-fable-5-1.
# MIND_MODEL=claude-haiku-5-5
# MIND_MODEL_DIALOGUE=
# MIND_MODEL_PRECHECK=
# MIND_MODEL_PLAN=
# MIND_MODEL_REFLECT=
# MIND_MODEL_GOSSIP=
# MIND_MODEL_PRESS=
# MIND_MODEL_ARRIVAL=
# MIND_MODEL_SUMMARY=

# ════════════════════════════════════════════════════════════════
# Server — alternative: local/free LLM on an OpenAI-compatible endpoint
# (Ollama, llama.cpp server, LM Studio). Uncomment this block and leave the
# ANTHROPIC_* lines above commented out. Dialogue then takes the cheap path:
# the small model writes the resident's lines and the engine disposes the
# choices and effects (server/src/mind/cheapDialogue.ts, reactions.ts).
# Every call costs $0 against the world budgets.
# ════════════════════════════════════════════════════════════════
# One-time setup (Ollama):
#   ollama pull gemma4:e2b              # the dialogue model (small, local)
#   ollama pull nomic-embed-text        # optional: embeddings for the cheap-path scorer
#   ollama serve                        # keep it running; listens on 127.0.0.1:11434
#
# MIND_PROVIDER=openai
# MIND_MODEL=gemma4:e2b                 # required: a model name the endpoint serves
# MIND_BASE_URL=http://127.0.0.1:11434/v1   # already the default when MIND_PROVIDER=openai
# MIND_API_KEY=                         # only if your endpoint wants a bearer key
# MIND_EMBED_MODEL=nomic-embed-text     # optional: embedding-ranked choices and regard
# Per-role overrides work the same way (MIND_MODEL_DIALOGUE=... etc.); on the
# openai path they take any model name, not just Claude ids.

# ════════════════════════════════════════════════════════════════
# Server — common (both providers)
# ════════════════════════════════════════════════════════════════
# Postgres for worlds, ai_log and model-routing overrides; without it the
# world and talk routes are off (health still answers).
# DATABASE_URL=postgres://user:pass@localhost:5432/monde
# Session (non-pooled) URL migrations need; set for Supabase's pooler.
# DATABASE_DIRECT_URL=
# REDIS_URL=
PORT=8080
NODE_ENV=development
MONDE_ENV=dev
LOG_LEVEL=info
GIT_SHA=dev
# HMAC secret for world tokens; required when MONDE_ENV is staging/production.
# MONDE_TOKEN_SECRET=
# Comma-separated invite codes; outside dev an empty list denies world creation.
# MONDE_INVITE_CODES=
# Content root (residents/*.yaml, scenes, places); defaults to the repo's content/.
# MONDE_CONTENT_DIR=
# Enables the /admin/* routes, including the /admin/models routing overrides.
# ADMIN_TOKEN=
# Budget caps in USD (GDD §9.15); non-Claude (openai path) calls cost 0.
WORLD_DAILY_BUDGET_USD=0.06
GLOBAL_DAILY_BUDGET_USD=10
CENSUS_BUDGET_USD=3

# ════════════════════════════════════════════════════════════════
# Client (Vite build-time; loaded from .env automatically)
# ════════════════════════════════════════════════════════════════
# The server the game talks to; without it the client uses its built-in
# default (the dev server origin).
# VITE_MIND_URL=http://127.0.0.1:8080
# Personal test builds only: a built-in invite code so the build is online
# from first launch. Never set it for a shared build.
# VITE_MIND_INVITE=
